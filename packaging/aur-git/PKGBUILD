# Maintainer: Glory42 <https://github.com/Glory42>
#
# rigcheck-git: built from the latest master, the "nightly" next to the
# stable rigcheck-bin. pkgver comes from git, so this file only changes when
# the build does; users rebuild with `yay -Syu --devel`.
pkgname=rigcheck-git
pkgver=1.0.0.r0.g4b725b6
pkgrel=1
pkgdesc="Check which Steam games your PC can run on Linux (latest master)"
arch=('x86_64')
url="https://github.com/Glory42/rigcheck"
license=('MIT')
# The same runtime needs as rigcheck-bin: glibc and libgcc, with the
# windowing and GPU libraries loaded at runtime.
depends=('gcc-libs' 'glibc' 'libxkbcommon')
makedepends=('git' 'cargo')
optdepends=(
  'wayland: Wayland sessions'
  'libxcursor: X11 sessions'
  'libxrandr: X11 sessions'
  'libxi: X11 sessions'
  'vulkan-icd-loader: GPU rendering (falls back to software without it)'
  'vulkan-tools: vulkaninfo, for Vulkan version and VRAM detection'
)
provides=('rigcheck')
conflicts=('rigcheck')
# makepkg's LTO turns aws-lc's C (under rustls) into GCC bitcode, which
# Rust's linker can't read.
options=('!lto')
source=("rigcheck::git+$url.git")
sha256sums=('SKIP')

# "0.8.0.r3.g5f46a4e": three commits after v0.8.0. Only v* tags: the
# rolling db-latest tag is a database release, not a version.
pkgver() {
  cd rigcheck
  git describe --long --tags --match 'v*' | sed 's/^v//;s/-\([0-9]*\)-g/.r\1.g/'
}

prepare() {
  cd rigcheck
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd rigcheck
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p rigcheck
}

# The installed layout of packaging/package.sh.
package() {
  cd rigcheck
  local id=dev.gorkemkaryol.rigcheck
  install -Dm755 target/release/rigcheck "$pkgdir/usr/bin/rigcheck"
  install -Dm644 "packaging/$id.desktop" "$pkgdir/usr/share/applications/$id.desktop"
  install -Dm644 "packaging/$id.metainfo.xml" "$pkgdir/usr/share/metainfo/$id.metainfo.xml"
  for size in 128 256 512; do
    install -Dm644 "assets/brand/icon-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$id.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
